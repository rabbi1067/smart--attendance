# Configure these ONLY in Render's backend environment, never in GitHub Pages.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/smart_attendance
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<long-random-password>
SITE_OWNER_EMAIL=admin@example.com
ADMIN_USERS_JSON=[]
JWT_SECRET=<random-64-char-secret>
# Generate with: openssl rand -base64 32
MAIL_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
# Allowed *frontend origins*, without path. GitHub Pages includes github.io origin (not /repo-name).
FRONTEND_ORIGINS=https://YOUR-USERNAME.github.io,http://localhost:3000
# GitHub repository Settings > Secrets and variables > Actions > Variables (NOT secret)
# API_BASE_URL=https://YOUR-RENDER-API.onrender.com
